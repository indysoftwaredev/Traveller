@using Traveller.Models
@model Ship

<div class="card mt-4" id="shipSummary">
    <div class="card-header">
        <div>@Model.Name</div>
        <div>Hull: @(Model.Hull.TonsDisplacement)t @Html.DisplayFor(m => m.Hull.HullConfiguration)</div>
        <div>Cost (MCr): @Model.TotalCostMCr</div>
        <div>Hull Points: @Model.HullPoints</div>
        <div>Cargo: @(Model.CargoSpace)t</div>
        @if(Model.ProtectionPoints > 0) { <div>Protection Points: @Model.ProtectionPoints</div> }
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Component</th>
                    <th>Tech Level</th>
                    <th>Tonnage</th>
                    <th>Power</th>
                    <th>Cost (MCr)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var component in Model.Components)
                {
                    <tr>
                        <td>@component.Name</td>
                        <td>@component.TechLevel</td>
                        <td>@component.TonsDisplacement</td>
                        <td>@component.PowerRequired</td>
                        <td>@component.CostMCr</td>
                        <td></td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm delete-component">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>