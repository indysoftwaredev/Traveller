@model Ship
@{
    ViewData["Title"] = "Ship Builder - Hull Selection";
}

<div class="container">
    <input type="hidden" id="shipModel" value="@Model" />
    <div id="shipSummaryContainer">
        @await Html.PartialAsync("_ShipSummary.cshtml", Model)
    </div>

    <div class="card mt-3">
        <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#hullSelectionSection" aria-expanded="true" aria-controls="hullSelectionSection">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Create Hull</h4>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
        <div id="hullSelectionSection" class="collapse show">
            <form asp-action="SaveHull" method="post">
                <div class="card-body">
                    <div class="row mb-1">
                        <div class="col-md-3">
                            <label asp-for="Hull.HullConfiguration" class="form-label">Hull Configuration</label>
                            <select asp-for="Hull.HullConfiguration" asp-items="Html.GetEnumSelectList<HullConfiguration>()" class="form-select">
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Hull.TonsDisplacement" class="form-label">Displacement (tons)</label>
                            <input asp-for="Hull.TonsDisplacement" type="number" class="form-control" />
                            <span asp-validation-for="Hull.TonsDisplacement" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Hull.Construction" class="form-label">Hull Construction</label>
                            <select asp-for="Hull.Construction" asp-items="Html.GetEnumSelectList<Construction>()" class="form-select">
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">&nbsp;</label>
                            <div class="form-check pt-2">
                                <input asp-for="Hull.GravityHull" type="checkbox" class="form-check-input" />
                                <label asp-for="Hull.GravityHull" class="form-check-label">Gravity Hull</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#armorSelectionSection" aria-expanded="true" aria-controls="armorSelectionSection">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Add Armor</h4>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
        <div id="armorSelectionSection" class="collapse show">
            <form asp-action="AddArmor" method="post">
                <div class="card-body">
                    <div class="row mb-1">
                        <div class="col-md-2">
                            <label class="form-label">Armor Type</label>
                            <select name="ArmorType" class="form-select" id="armorType" asp-items="Html.GetEnumSelectList<ArmorType>()">
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Protection Level</label>
                            <input type="number" name="ProtectionLevel" class="form-control" id="protectionLevel" min="1" value="1" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Cost (Cr):</label>
                            <input type="text" class="form-control" id="costMCr" readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tonnage:</label>
                            <input type="text" class="form-control" id="tonsDisplacement" readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tech Level:</label>
                            <input type="text" class="form-control" id="techLevel" readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">Add Armor</button>
                        </div>
                    </div>

                    <div class="row">
                    </div>
                </div>
                <div class="card-footer">
                    
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script type="module" src="~/js/shipBuilder.js"></script>
    }
</div>